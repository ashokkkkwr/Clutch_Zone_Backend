datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
}
model games {
  id               Int          @id @default(autoincrement())
  game_name        String       @map("game_name")
  game_cover_image String?      @map("game_cover_image")
  game_icon        String?      @map("game_icon")
  tournaments      tournament[]
  in_game_ids      in_game_id[]

  game_favaurites game_favaurites[]
}

model in_game_id {
  id        Int    @id @default(autoincrement())
  player_id String @map("player_id")
  user_id   Int    @unique // Ensure this is unique
  game_id   Int
  user      user   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  game      games  @relation(fields: [game_id], references: [id],onDelete: Cascade)

}


model prize_pool {
  id            Int        @id @default(autoincrement())
  prize         Int
  placements    Int
  tournament    tournament @relation(fields: [tournament_id], references: [id],onDelete: Cascade)
  tournament_id Int
}

model teams {
  id                 Int           @id @default(autoincrement())
  team_name          String        @unique @map("team_name")
  logo               String?
  max_players        Int           @map("max_players")
  description        String?
  wins               Int           @default(0)
  tournaments_played Int           @default(0) @map("tournaments_played")
  teamPlayers        TeamPlayers[]
  Participant        Participant[]
  matchesAsTeam1     Match[]       @relation(name: "Team1")
  matchesAsTeam2     Match[]       @relation(name: "Team2")
  Match              Match[]       @relation(name: "WinnerTeam")
  //make nullable

CreatedAt          DateTime?     @default(now())
  TeamJoinRequest TeamJoinRequest[]

  team_media team_media[]
}
model team_media{
  id        Int    @id @default(autoincrement())
  team_id   Int
  media_url String @map("media_url")
  type      String @map("type")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  team teams @relation(fields: [team_id], references: [id])
  user_id Int
  user user @relation(fields: [user_id], references: [id], onDelete: Cascade)
 
}

model TeamJoinRequest {
  id        Int           @id @default(autoincrement())
  team_id   Int
  user_id   Int
  status    RequestStatus @default(PENDING)
  createdAt DateTime      @default(now()) @map("created_at")
  updatedAt DateTime      @updatedAt @map("updated_at")

  team teams @relation(fields: [team_id], references: [id])
  user user  @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@map("team_join_requests")
}

enum RequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model TeamPlayers {
  id      Int            @id @default(autoincrement())
  role    TeamPlayerRole @default(PLAYER) @map("role")
  team_id Int
  user_id Int            @unique
  team    teams          @relation(fields: [team_id], references: [id], onDelete: Cascade)
  user    user           @relation(fields: [user_id], references: [id],onDelete: Cascade)
}

enum TeamPlayerRole {
  PLAYER
  TEAM_LEADER
}

model tournament_history {
  id           Int        @id @default(autoincrement())
  tournamentId Int
  Tournament   tournament @relation(fields: [tournamentId], references: [id])
}

model tournament {
  id                                 Int       @id @default(autoincrement())
  tournament_name                    String    @map("tournament_name")
  tournament_icon                    String?   @map("tournament_icon")
  tournament_cover                   String?   @map("tournament_cover")
  tournament_description             String    @map("tournament_description")
  tournament_entry_fee               Float?    @map("tournament_entry_fee")
  tournament_registration_start_date DateTime  @map("tournament_registration_start_date")
  tournament_registration_end_date   DateTime  @map("tournament_registration_end_date")
  tournament_start_date              DateTime  @map("tournament_start_date")
  tournament_end_date                DateTime  @map("tournament_end_date")
  tournament_game_mode               String    @map("tournament_game_mode")
  tournament_streaming_link          String?   @map("tournament_streaming_link")
  featured_tournament                Boolean   @default(false) @map("featured_tournament")
  games_id                           Int
  total_player                       Int
  games                              games     @relation(fields: [games_id], references: [id])
  status          TournamentStatus @default(UPCOMING)
match_interval Int @default(30)
  prize_pools        prize_pool[]
  tournament_results tournament_result[]
  tournament_history tournament_history[]
  bracket            Bracket? // Relation without `fields` or `references`
  participants       Participant[]
  matches            Match[]
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  winnerId           Int? // New field to store the winner
  winner             user?                @relation(fields: [winnerId], references: [id], onDelete: Cascade)
  is_points_based    Boolean              @default(false) // New field to indicate points-based tournament
  total_rounds       Int? // Number of rounds in the tournament

  Notification Notification[]
}

model Bracket {
  id           Int        @id @default(autoincrement())
  totalPlayers Int        @default(0)
  tournamentId Int        @unique
  tournament   tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  user_id      Int?
  user         user?      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
}

enum TournamentStatus {
  UPCOMING
  IN_PROGRESS
  COMPLETED
}

enum MatchStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
}

model Match {
  id           Int        @id @default(autoincrement())
  tournament   tournament @relation(fields: [tournamentId], references: [id])
  tournamentId Int
  round        Int
  position     Int
  player1Id    Int?
  player2Id    Int?
  winnerId     Int?
  player1      user?      @relation(name: "Player1", fields: [player1Id], references: [id], onDelete: Cascade)
  player2      user?      @relation(name: "Player2", fields: [player2Id], references: [id],onDelete: Cascade)
  winner       user?      @relation(name: "Winner", fields: [winnerId], references: [id], onDelete: Cascade)
  team1Id      Int?
  team2Id      Int?
  winnerTeamId Int?
  team1        teams?     @relation(name: "Team1", fields: [team1Id], references: [id])
  team2        teams?     @relation(name: "Team2", fields: [team2Id], references: [id])
  winnerTeam   teams?     @relation(name: "WinnerTeam", fields: [winnerTeamId], references: [id])
  scoreSubmitted Boolean @default(false) @map("score_submitted")
  status          MatchStatus       @default(SCHEDULED)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  match_time      DateTime?
  ScoreSubmission ScoreSubmission[]
  @@unique([tournamentId, round, position])
  @@map("matches")
  Notification Notification[]
}


model ScoreSubmission {
  id            Int              @id @default(autoincrement())
  matchId       Int
  match         Match            @relation(fields: [matchId], references: [id],onDelete: Cascade)
  kills         Int? // For points-based tournaments
  placement     Int? // For points-based tournaments
  playerScore   Int? // For elimination (user's score)
  screenshot    String
  submittedBy   Int // User ID of submitter
  isTeam        Boolean          @default(false)
  status        SubmissionStatus @default(PENDING)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
    teamId        Int?             @map("team_id") // Add this line

}
enum SubmissionStatus {
  PENDING
  APPROVED
  REJECTED
}
model user {
  id                  Int                  @id @default(autoincrement())
  username            String
  email               String               @unique
  google_id           String?              @map("google_id")
  password            String
  clutch_bucks        Int                  @default(0)
  role                String               @default("USER")
  avatar              String               @default("uploads/avatar/avatar.png")
  bio                 String?
  wins                Int                  @default(0)
  tournaments_played  Int                  @default(0) @map("tournaments_played")
  otp                 String?
  xp                  Int                  @default(0)
  location            String?
  current_level       Int                  @default(1)
  otpExpiration       DateTime?
  wallet              wallet[]
  teamPlayers         TeamPlayers?
  in_game_ids         in_game_id[]
  Withdraw_request    withdraw_request[]
  gear_purchases      gear_purchase[]
  top_up_transactions top_up_transaction[]
  purchases           gear_transaction[]
token          String?        
otpVerified Boolean @default(false)
  Bracket                   Bracket[]
  participants              Participant[]
  matchesAsPlayer1          Match[]                     @relation(name: "Player1")
  matchesAsPlayer2          Match[]                     @relation(name: "Player2")
  matchesAsWinner           Match[]                     @relation(name: "Winner")
  tournament                tournament[]
  TeamJoinRequest           TeamJoinRequest[]
  payment_bucks_transaction payment_bucks_transaction[]
  createdAt    DateTime   @default(now())
  game_favaurites game_favaurites[]
  team_media team_media[]
  Notification Notification[]

  CartItem CartItem[]

  Order Order[]
}

model Participant {
  id           Int        @id @default(autoincrement())
  userId       Int?
  user         user?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  teamId       Int?
  team         teams?     @relation(fields: [teamId], references: [id])
  tournament   tournament @relation(fields: [tournamentId], references: [id], onDelete: Cascade)
  tournamentId Int
  seed         Int?
  points       Int        @default(0)
  createdAt    DateTime   @default(now())
  @@unique([userId, tournamentId])
  @@map("participants")
}
model tournament_result {
  id            Int        @id @default(autoincrement())
  placement     String?
  tournament_id Int
  time_slot_id  Int
  tournament    tournament @relation(fields: [tournament_id], references: [id])
}
model wallet {
  id           Int                  @id @default(autoincrement())
  balance      Float                @default(0.0)
  user_id      Int                  @unique
  user         user                 @relation(fields: [user_id], references: [id], onDelete: Cascade)
  transactions wallet_transaction[]
}
model withdraw_request {
  id                  Int     @id @default(autoincrement())
  withdraw_amount     Float   @map("withdraw_amount")
  payment_method      String? @map("payment_method")
  wallet_number       String? @map("wallet_number")
  account_holder_name String? @map("account_holder_name")
  account_number      String? @map("account_number")
  bank_name           String? @map("bank_name")
  status              String  @default("pending")
  user_id             Int
  user                user    @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

enum Role {
  SUDO_ADMIN
  SUPER_ADMIN
  ADMIN
  USER
}

model gear {
  id               Int                @id @default(autoincrement())
  name             String             @unique
  description      String?
  price            Float
  image            String?
  stock            Int                @default(0)
  created_at       DateTime           @default(now())
  updated_at       DateTime           @updatedAt
  gear_purchase    gear_purchase[]
  gear_transaction gear_transaction[]

  CartItem CartItem[]

  OrderItem OrderItem[]
}

model gear_purchase {
  id           Int      @id @default(autoincrement())
  gear_id      Int
  user_id      Int
  quantity     Int      @default(1)
  total_cost   Float    @map("total_cost")
  purchased_at DateTime @default(now())
  gear         gear     @relation(fields: [gear_id], references: [id], onDelete: Cascade)
  user         user     @relation(fields: [user_id], references: [id], onDelete: Cascade)
}

model top_up_option {
  id                  Int                  @id @default(autoincrement())
  name                String               @map("name") // Subscription or top-up option name
  description         String?              @map("description")
  price               Float                @map("price") // Cost of the top-up
  amount              Int?                 @map("amount") // Duration in days for subscriptions
  // is_active   Boolean @default(true) @map("is_active")
  created_at          DateTime             @default(now())
  updated_at          DateTime             @updatedAt
  top_up_transactions top_up_transaction[]
}

model top_up_transaction {
  id               Int           @id @default(autoincrement())
  user_id          Int
  top_up_option_id Int
  transaction_id   String? // Reference to external payment ID
  status           String        @default("pending") // e.g., "completed", "failed"
  created_at       DateTime      @default(now())
  user             user          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  top_up_option    top_up_option @relation(fields: [top_up_option_id], references: [id])
}

model wallet_transaction {
  id          Int      @id @default(autoincrement())
  type        String
  amount      Float
  description String?
  created_at  DateTime @default(now())
  wallet_id   Int
  wallet      wallet   @relation(fields: [wallet_id], references: [id])
}

model gear_transaction {
  id          Int      @id @default(autoincrement())
  user_id     Int
  gear_id     Int
  quantity    Int
  total_price Float
  created_at  DateTime @default(now())
  user        user     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  gear        gear     @relation(fields: [gear_id], references: [id], onDelete: Cascade)
}

model payment_bucks {
  id           Int                         @id @default(autoincrement())
  amount       Int
  price        Int
  description  String
  bonus        Int
  buckImage    String
  transactions payment_bucks_transaction[] // Relation with transactions
}

model payment_bucks_transaction {
  id               Int           @id @default(autoincrement())
  user_id          Int
  payment_bucks_id Int
  user             user          @relation(fields: [user_id], references: [id], onDelete: Cascade)
  payment_bucks    payment_bucks @relation(fields: [payment_bucks_id], references: [id] )
}

model game_favaurites {
  id      Int   @id @default(autoincrement())
  user_id Int
  user    user  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  game_id Int
  games   games @relation(fields: [game_id], references: [id])
}
model Notification {
  id                  Int               @id @default(autoincrement())
  userId              Int
  user                user              @relation(fields: [userId], references: [id])
  message             String
  type                NotificationType
  relatedTournamentId Int?              // Links to tournament if applicable
  tournament          tournament?       @relation(fields: [relatedTournamentId], references: [id])
  relatedMatchId      Int?              // Links to match if applicable
  match               Match?            @relation(fields: [relatedMatchId], references: [id])
  read                Boolean           @default(false)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
}
enum NotificationType {
  TOURNAMENT_CREATED
  MATCH_STARTING
}
model CartItem {
  id        Int    @id @default(autoincrement())
  user      user   @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    Int
  gear      gear   @relation(fields: [gearId], references: [id], onDelete: Cascade)
  gearId    Int
  quantity  Int    @default(1)

  @@unique([userId, gearId])
}

model Order {
  id         Int          @id @default(autoincrement())
  user      user         @relation(fields: [userId], references: [id],onDelete: Cascade)
  userId     Int
  totalPrice Float
  createdAt  DateTime     @default(now())
  items      OrderItem[]
}

model OrderItem {
  id        Int    @id @default(autoincrement())
  order     Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId   Int
  gear      gear   @relation(fields: [gearId], references: [id],onDelete: Cascade)
  gearId    Int
  quantity  Int
  unitPrice Float
}

